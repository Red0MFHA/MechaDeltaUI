# mock: typed in-browser mock services (default). http: real MechaDelta API (not implemented yet).
NEXT_PUBLIC_DATA_MODE=mock
# Used only when NEXT_PUBLIC_DATA_MODE=http.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only HMAC for the mock session cookie. Change in any shared environment.
MOCK_SESSION_SECRET=mechadelta-mock-session-dev-secret
